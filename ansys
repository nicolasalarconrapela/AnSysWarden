#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="$ROOT_DIR/.ansyswarden"
LOG_DIR="$STATE_DIR/logs"
OLLAMA_PID_FILE="$STATE_DIR/ollama.pid"
OLLAMA_LOG_FILE="$LOG_DIR/ollama.log"
CONFIG_FILE="${ANSYSWARDEN_CONFIG_FILE:-${HOME:-$ROOT_DIR}/.ansyswarden/config.json}"
OLLAMA_HOST_URL="${OLLAMA_HOST_URL:-http://127.0.0.1:11434}"
MODEL="${ANSYSWARDEN_MODEL:-gemma4:e2b}"
AI_NUM_CTX="${ANSYSWARDEN_AI_NUM_CTX:-1024}"
AI_KEEP_ALIVE="${ANSYSWARDEN_AI_KEEP_ALIVE:-45s}"

mkdir -p "$LOG_DIR"

info() { printf '[✓] %s\n' "$*"; }
warn() { printf '[!] %s\n' "$*" >&2; }
err() { printf '[✗] %s\n' "$*" >&2; }

normalize_language() {
  case "${1,,}" in
    en|en-*|en_*) printf 'en' ;;
    es|es-*|es_*) printf 'es' ;;
    *) return 1 ;;
  esac
}

LANGUAGE_SOURCE='default'
LANGUAGE_CONFIGURED='no'
LANGUAGE_NOTICE_REQUIRED='no'

load_language_from_config() {
  local lang=''

  if [[ -n "${ANSYSWARDEN_LANG:-}" ]]; then
    if lang="$(normalize_language "$ANSYSWARDEN_LANG")"; then
      export ANSYSWARDEN_LANG="$lang"
      LANGUAGE_SOURCE='environment'
      LANGUAGE_CONFIGURED='no'
      return 0
    fi
    warn "Ignoring unsupported ANSYSWARDEN_LANG='$ANSYSWARDEN_LANG'."
    unset ANSYSWARDEN_LANG
  fi

  if [[ -f "$CONFIG_FILE" ]] && command -v node >/dev/null 2>&1; then
    lang="$(node -e '
      const fs = require("fs");
      try {
        const cfg = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
        const lang = typeof cfg.language === "string" ? cfg.language.toLowerCase() : "";
        if (lang === "en" || lang === "es") process.stdout.write(lang);
      } catch {}
    ' "$CONFIG_FILE" 2>/dev/null || true)"

    if [[ "$lang" == "en" || "$lang" == "es" ]]; then
      export ANSYSWARDEN_LANG="$lang"
      LANGUAGE_SOURCE='config'
      LANGUAGE_CONFIGURED='yes'
      return 0
    fi
  fi

  export ANSYSWARDEN_LANG='en'
  LANGUAGE_SOURCE='default'
  LANGUAGE_CONFIGURED='no'
  LANGUAGE_NOTICE_REQUIRED='yes'
  return 0
}

apply_global_options() {
  local args=("$@")
  local cleaned=()
  local i=0
  local value lang

  while ((i < ${#args[@]})); do
    if [[ "${args[$i]}" == "--lang" ]]; then
      if ((i + 1 >= ${#args[@]})); then
        err "--lang requires en or es."
        exit 1
      fi
      value="${args[$((i + 1))]}"
      if ! lang="$(normalize_language "$value")"; then
        err "Unsupported language '$value'. Use en or es."
        exit 1
      fi
      export ANSYSWARDEN_LANG="$lang"
      LANGUAGE_SOURCE='argument'
      LANGUAGE_NOTICE_REQUIRED='no'
      i=$((i + 2))
      continue
    fi
    cleaned+=("${args[$i]}")
    i=$((i + 1))
  done

  GLOBAL_ARGS=("${cleaned[@]}")
}

