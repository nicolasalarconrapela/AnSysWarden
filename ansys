require_command() {
  command -v "$1" >/dev/null 2>&1 || { err "$(msg missing_command "$1")"; exit 1; }
}

ollama_ready() { curl -fsS "$OLLAMA_HOST_URL/api/tags" >/dev/null 2>&1; }

ai_start() {
  require_command ollama
  require_command curl
  if ollama_ready; then info "$(msg ai.already_running "$OLLAMA_HOST_URL")"; ai_status; return; fi
  printf 'AnSysWarden\n────────────────────────\n'
  printf '%s\n' "$(msg ai.starting)"
  printf 'Model: %s\n' "$MODEL"
  nohup ollama serve >"$OLLAMA_LOG_FILE" 2>&1 &
  local pid=$!
  printf '%s\n' "$pid" > "$OLLAMA_PID_FILE"
  for _ in $(seq 1 30); do
    if ollama_ready; then info "Status: OK"; printf 'PID: %s\n' "$pid"; printf 'Log: %s\n' "$OLLAMA_LOG_FILE"; return; fi
    sleep 1
  done
  warn "$(msg ai.no_response)"
  tail -n 40 "$OLLAMA_LOG_FILE" 2>/dev/null || true
  exit 1
}

ai_stop() {
  if [[ ! -f "$OLLAMA_PID_FILE" ]]; then
    if ollama_ready; then
      warn "Ollama is running, but AnSysWarden has no registered PID for it."
      warn "For safety, a process started externally will not be stopped."
      return 2
    fi
    warn "There is no Ollama process managed by AnSysWarden."
    return
  fi
  local pid
  pid="$(cat "$OLLAMA_PID_FILE")"
  if [[ ! "$pid" =~ ^[0-9]+$ ]]; then rm -f "$OLLAMA_PID_FILE"; err "The registered PID is invalid. Local state is removed without stopping any process."; return 2; fi
  if ! kill -0 "$pid" 2>/dev/null; then rm -f "$OLLAMA_PID_FILE"; warn "The registered process (PID $pid) no longer exists. Local state cleaned."; return; fi
  local command_line
  command_line="$(ps -p "$pid" -o args= 2>/dev/null || true)"
  if [[ "$command_line" != *"ollama serve"* ]]; then err "PID $pid no longer belongs to 'ollama serve'."; err "For safety, NO signal will be sent to that process."; rm -f "$OLLAMA_PID_FILE"; return 2; fi
  kill "$pid"
  rm -f "$OLLAMA_PID_FILE"
  info "AnSysWarden-managed Ollama stopped (PID $pid)."
}

ai_status() {
  require_command curl
  printf 'Local AI\n────────────────────────\n'
  printf 'Ollama:   '
  if ollama_ready; then
    printf 'RUNNING\n'; printf 'Model:    %s\n' "$MODEL"; printf 'API:      %s\n' "$OLLAMA_HOST_URL"
    local started ended latency
    started="$(date +%s%3N 2>/dev/null || date +%s000)"
    curl -fsS "$OLLAMA_HOST_URL/api/tags" >/dev/null
    ended="$(date +%s%3N 2>/dev/null || date +%s000)"
    latency=$((ended - started))
    printf 'Latency:  %s ms\n' "$latency"
    [[ -f "$OLLAMA_PID_FILE" ]] && printf 'Own PID:  %s\n' "$(cat "$OLLAMA_PID_FILE")"
    printf 'Log:      %s\n' "$OLLAMA_LOG_FILE"
  else
    printf 'STOPPED\n'; printf 'API:      %s\n' "$OLLAMA_HOST_URL"; return 1
  fi
}

ai_models() {
  printf 'AnSysWarden models v1\n────────────────────────────────────────\n'
  printf 'gemma4:e2b    PRIMARY    best measured balance on S25 Ultra\n'
  printf 'gemma2:2b     REFERENCE  lighter; manual fallback\n'
  printf 'gemma3:1b     SECONDARY  lightweight but less stable in our tests\n'
  printf 'qwen3:0.6b    REJECTED   timeouts on the CORE dataset\n'
  printf '\nSafety policy:\n  Only local rules may authorize SAFE_CACHE.\n  AI only provides evidence and may lead to protection or review.\n'
  printf '\nInstall primary model:\n  ./ansys ai pull-mobile-candidate\n'
  printf '\nCompare primary and reference models:\n  ./ansys test mobile-models\n'
  printf '\nTemporarily force the reference model:\n  ANSYSWARDEN_MODEL=%q ./ansys classify <path>\n' 'gemma2:2b'
}

ai_pull() {
  require_command ollama
  local requested_model="${1:-}"
  [[ -n "$requested_model" ]] || { err "Model name is required."; ai_models; exit 1; }
  printf 'AnSysWarden · Download model\n────────────────────────────────────────\nModel:  %s\nEngine: Ollama\n\n' "$requested_model"
  ollama pull "$requested_model"
  info "Model downloaded: $requested_model"
  printf 'To test it without changing global configuration:\n  ANSYSWARDEN_MODEL=%q ./ansys test benchmark --offset 0 --limit 10\n' "$requested_model"
}

ai_pull_mobile_candidate() { printf 'AnSysWarden · Mobile model v1\n────────────────────────────────────────\nModel: gemma4:e2b\nRole:  primary local AI model\n\n'; ai_pull 'gemma4:e2b'; }

ai_test() {
  require_command curl
  require_command jq
  if ! ollama_ready; then err "Ollama is not responding. Run: ./ansys ai start"; exit 1; fi
  info "$(msg ai.responding)"
  local tags
  tags="$(curl -fsS "$OLLAMA_HOST_URL/api/tags")"
  if jq -e --arg model "$MODEL" 'any(.models[]?; ((.name // "") | startswith($model)))' <<<"$tags" >/dev/null 2>&1; then info "Model $MODEL is available"; else warn "Model $MODEL was not found among installed models."; fi
  local payload response text
  payload="$(jq -n --arg model "$MODEL" --arg keep "$AI_KEEP_ALIVE" --argjson ctx "$AI_NUM_CTX" '{model:$model,prompt:"Reply exactly: ANSYSWARDEN_OK",stream:false,think:false,keep_alive:$keep,options:{temperature:0,num_ctx:$ctx,num_predict:16}}')"
  response="$(curl -fsS -H 'Content-Type: application/json' -d "$payload" "$OLLAMA_HOST_URL/api/generate")"
  text="$(jq -r '.response // empty' <<<"$response" | tr -d '\r' | xargs)"
  if [[ "$text" == *"ANSYSWARDEN_OK"* ]]; then info "$(msg ai.inference_ok)"; printf 'Mobile profile: ctx=%s keep_alive=%s\n' "$AI_NUM_CTX" "$AI_KEEP_ALIVE"; printf '\n%s:\n%s\n' "$(msg ai.response)" "$text"; else err "Inference returned an unexpected response: $text"; exit 1; fi
}

run_ts() {
  if [[ ! -x "$ROOT_DIR/node_modules/.bin/tsx" ]]; then err "$(msg deps_missing)"; printf '%s\n  npm install\n' "$(msg run_once)"; exit 1; fi
  exec "$ROOT_DIR/node_modules/.bin/tsx" "$@"
}

show_logs() {
  local raw="${1:-}"
  if [[ "$raw" == "--raw" ]]; then
    shopt -s nullglob
    local files=("$LOG_DIR"/*.jsonl)
    if ((${#files[@]} == 0)); then warn "No JSONL traces exist yet."; return; fi
    cat "${files[@]}"
    return
  fi
  printf 'AnSysWarden logs\n────────────────────────\nOllama: %s\n' "$OLLAMA_LOG_FILE"
  if [[ -f "$OLLAMA_LOG_FILE" ]]; then tail -n 30 "$OLLAMA_LOG_FILE"; else warn "The Ollama log does not exist yet."; fi
  printf '\nStructured traces:\n'
  find "$LOG_DIR" -maxdepth 1 -name '*.jsonl' -type f -printf '  %f\n' 2>/dev/null | sort || true
}

main() {
  local command="${1:-}"
  case "$command" in
    ai)
      case "${2:-}" in
        start) ai_start ;;
        stop) ai_stop ;;
        status) ai_status ;;
        test) ai_test ;;
        models) ai_models ;;
        pull) ai_pull "${3:-}" ;;
        pull-mobile-candidate) ai_pull_mobile_candidate ;;
        *) usage; exit 1 ;;
      esac
      ;;
    worker)
      case "${2:-}" in
        mobile) shift 2; run_ts "$ROOT_DIR/src/worker/mobile-worker.ts" "$@" ;;
        *) err "$(msg unknown_worker "${2:-}")"; usage; exit 1 ;;
      esac
      ;;
    doctor) run_ts "$ROOT_DIR/src/cli.ts" doctor ;;
    classify) [[ -n "${2:-}" ]] || { err "$(msg path_classify)"; exit 1; }; run_ts "$ROOT_DIR/src/cli.ts" classify "$2" ;;
    scan) [[ -n "${2:-}" ]] || { err "$(msg path_scan)"; exit 1; }; shift; run_ts "$ROOT_DIR/src/cli.ts" scan "$@" ;;
    dust) shift; run_ts "$ROOT_DIR/src/dust/dust-cli.ts" "$@" ;;
    inspect) [[ -n "${2:-}" ]] || { err "$(msg path_inspect)"; exit 1; }; run_ts "$ROOT_DIR/src/profiler/inspect-cli.ts" "$2" ;;
    backend) shift; run_ts "$ROOT_DIR/src/backend/backend-cli.ts" "$@" ;;
    test)
      case "${2:-}" in
        safety) run_ts "$ROOT_DIR/src/cli.ts" test safety ;;
        rules) run_ts "$ROOT_DIR/src/tests/rules-safety-cli.ts" ;;
        overlap) run_ts "$ROOT_DIR/src/tests/scanner-overlap-cli.ts" ;;
        tree) run_ts "$ROOT_DIR/src/tests/tree-policy-cli.ts" ;;
        context) run_ts "$ROOT_DIR/src/tests/project-context-cli.ts" ;;
        candidates) run_ts "$ROOT_DIR/src/tests/ai-candidate-cli.ts" ;;
        benchmark) shift 2; run_ts "$ROOT_DIR/src/tests/cache-benchmark-runner.ts" "$@" ;;
        models) shift 2; run_ts "$ROOT_DIR/src/tests/model-comparison-runner.ts" "$@" ;;
        mobile-models) shift 2; run_ts "$ROOT_DIR/src/tests/model-comparison-runner.ts" --models gemma4:e2b,gemma2:2b "$@" ;;
        e2e) shift 2; run_ts "$ROOT_DIR/src/tests/backend-gemma-e2e-cli.ts" "$@" ;;
        *) err "$(msg unknown_test "${2:-}")"; usage; exit 1 ;;
      esac
      ;;
    review)
      case "${2:-}" in
        export) [[ -n "${3:-}" ]] || { err "Path to export for review is required."; exit 1; }; run_ts "$ROOT_DIR/src/review/export-review.ts" "$3" ;;
        *) err "Unknown review command: ${2:-}"; usage; exit 1 ;;
      esac
      ;;
    logs) show_logs "${2:-}" ;;
    -h|--help|help|'') usage ;;
    *) err "$(msg unknown_command "$command")"; usage; exit 1 ;;
  esac
}

GLOBAL_ARGS=()
apply_global_options "$@"
main "${GLOBAL_ARGS[@]}"
