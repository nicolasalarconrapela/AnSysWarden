#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="$ROOT_DIR/.ansyswarden"
LOG_DIR="$STATE_DIR/logs"
OLLAMA_PID_FILE="$STATE_DIR/ollama.pid"
OLLAMA_LOG_FILE="$LOG_DIR/ollama.log"
OLLAMA_HOST_URL="${OLLAMA_HOST_URL:-http://127.0.0.1:11434}"
MODEL="${ANSYSWARDEN_MODEL:-gemma4:e2b}"
AI_NUM_CTX="${ANSYSWARDEN_AI_NUM_CTX:-1024}"
AI_KEEP_ALIVE="${ANSYSWARDEN_AI_KEEP_ALIVE:-45s}"

mkdir -p "$LOG_DIR"

info() { printf '[✓] %s\n' "$*"; }
warn() { printf '[!] %s\n' "$*" >&2; }
err() { printf '[✗] %s\n' "$*" >&2; }

normalize_language() {
  case "${1,,}" in
    en|en-*|en_*) printf 'en' ;;
    es|es-*|es_*) printf 'es' ;;
    *) return 1 ;;
  esac
}

apply_global_options() {
  local args=("$@")
  local cleaned=()
  local i=0
  local value lang

  while ((i < ${#args[@]})); do
    if [[ "${args[$i]}" == "--lang" ]]; then
      if ((i + 1 >= ${#args[@]})); then
        err "--lang requires en or es."
        exit 1
      fi
      value="${args[$((i + 1))]}"
      if ! lang="$(normalize_language "$value")"; then
        err "Unsupported language '$value'. Use en or es."
        exit 1
      fi
      export ANSYSWARDEN_LANG="$lang"
      i=$((i + 2))
      continue
    fi
    cleaned+=("${args[$i]}")
    i=$((i + 1))
  done

  set -- "${cleaned[@]}"
  GLOBAL_ARGS=("$@")
}

msg() {
  local key="$1"
  shift || true
  local lang="${ANSYSWARDEN_LANG:-en}"
  case "$lang:$key" in
    es:usage.note) printf 'La interfaz diaria no requiere usar npm directamente.' ;;
    es:missing_command) printf "No se encontró '%s' en PATH." "$1" ;;
    es:ai.already_running) printf 'Ollama ya está ejecutándose en %s' "$1" ;;
    es:ai.starting) printf 'IA local: iniciando Ollama...' ;;
    es:ai.no_response) printf 'Ollama no respondió después de 30 segundos.' ;;
    es:ai.responding) printf 'Ollama responde' ;;
    es:ai.inference_ok) printf 'Inferencia correcta' ;;
    es:ai.response) printf 'Respuesta' ;;
    es:deps_missing) printf 'Las dependencias TypeScript todavía no están instaladas.' ;;
    es:run_once) printf 'Ejecuta una vez:' ;;
    es:unknown_worker) printf 'Worker desconocido: %s' "$1" ;;
    es:path_classify) printf 'Falta la ruta que quieres clasificar.' ;;
    es:path_scan) printf 'Falta la ruta que quieres escanear.' ;;
    es:path_inspect) printf 'Falta la ruta que quieres inspeccionar.' ;;
    es:unknown_test) printf 'Test desconocido: %s' "$1" ;;
    es:unknown_command) printf 'Comando desconocido: %s' "$1" ;;
    *)
      case "$key" in
        usage.note) printf 'The daily interface does not require using npm directly.' ;;
        missing_command) printf "'%s' was not found in PATH." "$1" ;;
        ai.already_running) printf 'Ollama is already running at %s' "$1" ;;
        ai.starting) printf 'Local AI: starting Ollama...' ;;
        ai.no_response) printf 'Ollama did not respond after 30 seconds.' ;;
        ai.responding) printf 'Ollama is responding' ;;
        ai.inference_ok) printf 'Inference succeeded' ;;
        ai.response) printf 'Response' ;;
        deps_missing) printf 'TypeScript dependencies are not installed yet.' ;;
        run_once) printf 'Run once:' ;;
        unknown_worker) printf 'Unknown worker: %s' "$1" ;;
        path_classify) printf 'Path to classify is required.' ;;
        path_scan) printf 'Path to scan is required.' ;;
        path_inspect) printf 'Path to inspect is required.' ;;
        unknown_test) printf 'Unknown test: %s' "$1" ;;
        unknown_command) printf 'Unknown command: %s' "$1" ;;
        *) printf '%s' "$key" ;;
      esac
      ;;
  esac
}

