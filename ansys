# Presentación de ayuda: color solo cuando el terminal lo permite.
# NO_COLOR y TERM=dumb mantienen una salida legible sin ANSI.
help_banner() {
  local heading="AnSysWarden · CLI"
  if [[ -t 1 && -z "${NO_COLOR+x}" && "${TERM:-dumb}" != 'dumb' ]]; then
    printf '\033[1;36m  ◆ %s\033[0m\n' "$heading"
  else
    printf '  ◆ %s\n' "$heading"
  fi
  printf '  %s\n' '════════════════════════════════════════════════════════════'
}

