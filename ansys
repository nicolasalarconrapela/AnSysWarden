require_command() {
  command -v "$1" >/dev/null 2>&1 || { err "$(msg missing_command "$1")"; exit 1; }
}

ollama_ready() { curl -fsS "$OLLAMA_HOST_URL/api/tags" >/dev/null 2>&1; }

ai_start() {
  require_command ollama
  require_command curl
  if ollama_ready; then
    info "$(msg ai.already_running "$OLLAMA_HOST_URL")"
    ai_status
    return 0
  fi

  printf 'AnSysWarden\n────────────────────────\n'
  printf '%s\n' "$(msg ai.starting)"
  printf 'Model: %s\n' "$MODEL"
  nohup ollama serve >"$OLLAMA_LOG_FILE" 2>&1 &
  local pid=$!
  printf '%s\n' "$pid" > "$OLLAMA_PID_FILE"

  for _ in $(seq 1 30); do
    if ollama_ready; then
      info 'Status: OK'
      printf 'PID: %s\n' "$pid"
      printf 'Log: %s\n' "$OLLAMA_LOG_FILE"
      return 0
    fi
    sleep 1
  done

  warn "$(msg ai.no_response)"
  tail -n 40 "$OLLAMA_LOG_FILE" 2>/dev/null || true
  exit 1
}

ai_stop() {
  if [[ ! -f "$OLLAMA_PID_FILE" ]]; then
    if ollama_ready; then
      warn "$(msg ai.external_running)"
      warn "$(msg ai.external_not_stopped)"
      return 2
    fi
    warn "$(msg ai.no_managed_process)"
    return 0
  fi

  local pid
  pid="$(cat "$OLLAMA_PID_FILE")"

  if [[ ! "$pid" =~ ^[0-9]+$ ]]; then
    rm -f "$OLLAMA_PID_FILE"
    err "$(msg ai.invalid_pid)"
    return 2
  fi

  if ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$OLLAMA_PID_FILE"
    warn "$(msg ai.process_gone "$pid")"
    return 0
  fi

  local command_line
  command_line="$(ps -p "$pid" -o args= 2>/dev/null || true)"
  if [[ "$command_line" != *'ollama serve'* ]]; then
    err "$(msg ai.pid_not_ollama "$pid")"
    err "$(msg ai.no_signal)"
    rm -f "$OLLAMA_PID_FILE"
    return 2
  fi

  kill "$pid"
  rm -f "$OLLAMA_PID_FILE"
  info "$(msg ai.stopped "$pid")"
}

ai_status() {
  require_command curl
  printf '%s\n────────────────────────\n' "$(msg ai.local_title)"
  printf 'Ollama:   '

  if ollama_ready; then
    printf '%s\n' "$(msg ai.running)"
    printf 'Model:    %s\n' "$MODEL"
    printf 'API:      %s\n' "$OLLAMA_HOST_URL"
    local started ended latency
    started="$(date +%s%3N 2>/dev/null || date +%s000)"
    curl -fsS "$OLLAMA_HOST_URL/api/tags" >/dev/null
    ended="$(date +%s%3N 2>/dev/null || date +%s000)"
    latency=$((ended - started))
    printf 'Latency:  %s ms\n' "$latency"
    if [[ -f "$OLLAMA_PID_FILE" ]]; then
      printf '%s:  %s\n' "$(msg ai.own_pid)" "$(cat "$OLLAMA_PID_FILE")"
    fi
    printf 'Log:      %s\n' "$OLLAMA_LOG_FILE"
    return 0
  fi

  printf '%s\n' "$(msg ai.stopped_state)"
  printf 'API:      %s\n' "$OLLAMA_HOST_URL"
  return 1
}

ai_models() {
  printf '%s\n' "$(msg ai.models_title)"
  printf '────────────────────────────────────────\n'
  printf 'gemma4:e2b    %-10s %s\n' "$(msg ai.primary)" "$(msg ai.best_balance)"
  printf 'gemma2:2b     %-10s %s\n' "$(msg ai.reference)" "$(msg ai.lighter)"
  printf 'gemma3:1b     %-10s %s\n' "$(msg ai.secondary)" "$(msg ai.less_stable)"
  printf 'qwen3:0.6b    %-10s %s\n' "$(msg ai.rejected)" "$(msg ai.timeouts_core)"
  printf '\n%s\n' "$(msg ai.safety_policy)"
  printf '  %s\n' "$(msg ai.local_only_safe)"
  printf '  %s\n' "$(msg ai.evidence_only)"
  printf '\n%s\n  ./ansys ai pull-mobile-candidate\n' "$(msg ai.install_primary)"
  printf '\n%s\n  ./ansys test mobile-models\n' "$(msg ai.compare_models)"
  printf '\n%s\n  ANSYSWARDEN_MODEL=%q ./ansys classify <path>\n' "$(msg ai.force_reference)" 'gemma2:2b'
}

ai_pull() {
  require_command ollama
  local requested_model="${1:-}"
  [[ -n "$requested_model" ]] || { err "$(msg ai.model_required)"; ai_models; exit 1; }

  printf '%s\n' "$(msg ai.download_title)"
  printf '────────────────────────────────────────\n'
  printf 'Model:  %s\n' "$requested_model"
  printf '%s: Ollama\n\n' "$(msg ai.engine)"
  ollama pull "$requested_model"
  info "$(msg ai.downloaded "$requested_model")"
  printf '%s\n' "$(msg ai.test_without_global)"
  printf '  ANSYSWARDEN_MODEL=%q ./ansys test benchmark --offset 0 --limit 10\n' "$requested_model"
}

ai_pull_mobile_candidate() {
  printf '%s\n' "$(msg ai.mobile_model_title)"
  printf '────────────────────────────────────────\n'
  printf 'Model: gemma4:e2b\n'
  printf '%s:  %s\n\n' "$(msg ai.role)" "$(msg ai.primary_role)"
  ai_pull 'gemma4:e2b'
}

ai_test() {
  require_command curl
  require_command jq

  if ! ollama_ready; then
    err "$(msg ai.not_responding)"
    exit 1
  fi

  info "$(msg ai.responding)"

  local tags
  tags="$(curl -fsS "$OLLAMA_HOST_URL/api/tags")"
  if jq -e --arg model "$MODEL" 'any(.models[]?; ((.name // "") | startswith($model)))' <<<"$tags" >/dev/null 2>&1; then
    info "$(msg ai.available "$MODEL")"
  else
    warn "$(msg ai.not_found "$MODEL")"
  fi

  local payload response text
  payload="$(jq -n --arg model "$MODEL" --arg keep "$AI_KEEP_ALIVE" --argjson ctx "$AI_NUM_CTX" '{model:$model,prompt:"Reply exactly: ANSYSWARDEN_OK",stream:false,think:false,keep_alive:$keep,options:{temperature:0,num_ctx:$ctx,num_predict:16}}')"
  response="$(curl -fsS -H 'Content-Type: application/json' -d "$payload" "$OLLAMA_HOST_URL/api/generate")"
  text="$(jq -r '.response // empty' <<<"$response" | tr -d '\r' | xargs)"

  if [[ "$text" == *'ANSYSWARDEN_OK'* ]]; then
    info "$(msg ai.inference_ok)"
    printf '%s: ctx=%s keep_alive=%s\n' "$(msg ai.mobile_profile)" "$AI_NUM_CTX" "$AI_KEEP_ALIVE"
    printf '\n%s:\n%s\n' "$(msg ai.response)" "$text"
    return 0
  fi

  err "$(msg ai.unexpected_response "$text")"
  exit 1
}

run_ts() {
  if [[ ! -x "$ROOT_DIR/node_modules/.bin/tsx" ]]; then
    err "$(msg deps_missing)"
    printf '%s\n  npm install\n' "$(msg run_once)"
    exit 1
  fi

  exec "$ROOT_DIR/node_modules/.bin/tsx" "$@"
}

show_logs() {
  local raw="${1:-}"

  if [[ "$raw" == '--raw' ]]; then
    shopt -s nullglob
    local files=("$LOG_DIR"/*.jsonl)
    if ((${#files[@]} == 0)); then
      warn "$(msg logs.none)"
      return 0
    fi
    cat "${files[@]}"
    return 0
  fi

  printf '%s\n────────────────────────\n' "$(msg logs.title)"
  printf 'Ollama: %s\n' "$OLLAMA_LOG_FILE"
  if [[ -f "$OLLAMA_LOG_FILE" ]]; then
    tail -n 30 "$OLLAMA_LOG_FILE"
  else
    warn "$(msg logs.ollama_missing)"
  fi

  printf '\n%s\n' "$(msg logs.structured)"
  find "$LOG_DIR" -maxdepth 1 -name '*.jsonl' -type f -printf '  %f\n' 2>/dev/null | sort || true
}

main() {
  local command="${1:-}"

  case "$command" in
    config)
      shift
      run_ts "$ROOT_DIR/src/config/config-cli.ts" "$@"
      ;;
    ai)
      case "${2:-}" in
        start) ai_start ;;
        stop) ai_stop ;;
        status) ai_status ;;
        test) ai_test ;;
        models) ai_models ;;
        pull) ai_pull "${3:-}" ;;
        pull-mobile-candidate) ai_pull_mobile_candidate ;;
        *) usage; exit 1 ;;
      esac
      ;;
    worker)
      case "${2:-}" in
        mobile) shift 2; run_ts "$ROOT_DIR/src/worker/mobile-worker.ts" "$@" ;;
        *) err "$(msg unknown_worker "${2:-}")"; usage; exit 1 ;;
      esac
      ;;
    doctor) run_ts "$ROOT_DIR/src/cli.ts" doctor ;;
    classify)
      [[ -n "${2:-}" ]] || { err "$(msg path_classify)"; exit 1; }
      run_ts "$ROOT_DIR/src/cli.ts" classify "$2"
      ;;
    scan)
      [[ -n "${2:-}" ]] || { err "$(msg path_scan)"; exit 1; }
      shift
      run_ts "$ROOT_DIR/src/cli.ts" scan "$@"
      ;;
    dust)
      shift
      run_ts "$ROOT_DIR/src/dust/dust-cli.ts" "$@"
      ;;
    inspect)
      [[ -n "${2:-}" ]] || { err "$(msg path_inspect)"; exit 1; }
      run_ts "$ROOT_DIR/src/profiler/inspect-cli.ts" "$2"
      ;;
    backend)
      shift
      run_ts "$ROOT_DIR/src/backend/backend-cli.ts" "$@"
      ;;
    test)
      case "${2:-}" in
        safety) run_ts "$ROOT_DIR/src/cli.ts" test safety ;;
        rules) run_ts "$ROOT_DIR/src/tests/rules-safety-cli.ts" ;;
        overlap) run_ts "$ROOT_DIR/src/tests/scanner-overlap-cli.ts" ;;
        tree) run_ts "$ROOT_DIR/src/tests/tree-policy-cli.ts" ;;
        context) run_ts "$ROOT_DIR/src/tests/project-context-cli.ts" ;;
        candidates) run_ts "$ROOT_DIR/src/tests/ai-candidate-cli.ts" ;;
        benchmark) shift 2; run_ts "$ROOT_DIR/src/tests/cache-benchmark-runner.ts" "$@" ;;
        models) shift 2; run_ts "$ROOT_DIR/src/tests/model-comparison-runner.ts" "$@" ;;
        mobile-models) shift 2; run_ts "$ROOT_DIR/src/tests/model-comparison-runner.ts" --models gemma4:e2b,gemma2:2b "$@" ;;
        e2e) shift 2; run_ts "$ROOT_DIR/src/tests/backend-gemma-e2e-cli.ts" "$@" ;;
        *) err "$(msg unknown_test "${2:-}")"; usage; exit 1 ;;
      esac
      ;;
    review)
      case "${2:-}" in
        export)
          [[ -n "${3:-}" ]] || { err "$(msg review_path)"; exit 1; }
          run_ts "$ROOT_DIR/src/review/export-review.ts" "$3"
          ;;
        *) err "$(msg unknown_review "${2:-}")"; usage; exit 1 ;;
      esac
      ;;
    logs) show_logs "${2:-}" ;;
    -h|--help|help|'') usage ;;
    *) err "$(msg unknown_command "$command")"; usage; exit 1 ;;
  esac
}

GLOBAL_ARGS=()
load_language_from_config
apply_global_options "$@"
show_language_notice_if_needed
main "${GLOBAL_ARGS[@]}"
