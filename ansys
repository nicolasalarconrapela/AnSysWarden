command_error() {
  local topic="$1"
  shift
  err "$*"
  printf '\n' >&2
  command_help "$topic" >&2
  exit 2
}

require_path_arg() {
  local topic="$1"
  local value="$2"
  if [[ -z "$value" || "$value" == -* ]]; then
    command_error "$topic" "Falta la ruta obligatoria. Consulta el ejemplo:"
  fi
}

main() {
  local command="${1:-}"

  if [[ "$command" != "help" && ( "${2:-}" == "--help" || "${2:-}" == "-h" || "${2:-}" == "help" ) ]]; then
    command_help "$command" "${3:-}"
    return 0
  fi

  case "$command" in
    config)
      shift
      run_ts "$ROOT_DIR/src/config/config-cli.ts" "$@"
      ;;
    ai)
      case "${2:-}" in
        start) ai_start ;;
        stop) ai_stop ;;
        status) ai_status ;;
        test) ai_test ;;
        models) ai_models ;;
        pull) ai_pull "${3:-}" ;;
        pull-mobile-candidate) ai_pull_mobile_candidate ;;
        *) command_error ai "Subcomando de IA desconocido." ;;
      esac
      ;;
    worker)
      case "${2:-}" in
        mobile) shift 2; run_ts "$ROOT_DIR/src/worker/mobile-worker.ts" "$@" ;;
        *) command_error worker "Subcomando de worker desconocido." ;;
      esac
      ;;
    doctor) run_ts "$ROOT_DIR/src/cli.ts" doctor ;;
    classify)
      require_path_arg classify "${2:-}"
      run_ts "$ROOT_DIR/src/cli.ts" classify "$2"
      ;;
    scan)
      require_path_arg scan "${2:-}"
      shift
      run_ts "$ROOT_DIR/src/cli.ts" scan "$@"
      ;;
    dust)
      shift
      run_ts "$ROOT_DIR/src/dust/dust-cli.ts" "$@"
      ;;
    tree)
      shift
      exec "$ROOT_DIR/ansys-tree" "$@"
      ;;
    help)
      shift
      case "${1:-}" in
        ''|-h|--help) usage ;;
        *) command_help "$@" ;;
      esac
      ;;
    inspect)
      require_path_arg inspect "${2:-}"
      run_ts "$ROOT_DIR/src/profiler/inspect-cli.ts" "$2"
      ;;
    backend)
      shift
      run_ts "$ROOT_DIR/src/backend/backend-cli.ts" "$@"
      ;;
    test)
      case "${2:-}" in
        safety) run_ts "$ROOT_DIR/src/cli.ts" test safety ;;
        rules) run_ts "$ROOT_DIR/tests/04-seguridad/rules-safety-cli.ts" ;;
        overlap) run_ts "$ROOT_DIR/tests/02-inventario/scanner-overlap-cli.ts" ;;
        tree) run_ts "$ROOT_DIR/tests/03-visor-html/tree-policy-cli.ts" ;;
        context) run_ts "$ROOT_DIR/tests/05-ia/project-context-cli.ts" ;;
        candidates) run_ts "$ROOT_DIR/tests/05-ia/ai-candidate-cli.ts" ;;
        benchmark) shift 2; run_ts "$ROOT_DIR/tests/05-ia/cache-benchmark-runner.ts" "$@" ;;
        models) shift 2; run_ts "$ROOT_DIR/tests/05-ia/model-comparison-runner.ts" "$@" ;;
        mobile-models) shift 2; run_ts "$ROOT_DIR/tests/05-ia/model-comparison-runner.ts" --models gemma4:e2b,gemma2:2b "$@" ;;
        e2e) shift 2; run_ts "$ROOT_DIR/tests/06-e2e/backend-gemma-e2e-cli.ts" "$@" ;;
        *) command_error test "Prueba desconocida." ;;
      esac
      ;;
    review)
      case "${2:-}" in
        export)
          require_path_arg review "${3:-}"
          run_ts "$ROOT_DIR/src/review/export-review.ts" "$3"
          ;;
        *) command_error review "Subcomando de revisión desconocido." ;;
      esac
      ;;
    logs) show_logs "${2:-}" ;;
    -h|--help|'') usage ;;
    *) err "$(msg unknown_command "$command")"; usage; exit 1 ;;
  esac
}

GLOBAL_ARGS=()
load_language_from_config
apply_global_options "$@"
show_language_notice_if_needed
main "${GLOBAL_ARGS[@]}"
