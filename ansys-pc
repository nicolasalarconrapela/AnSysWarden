#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ ! -x "$ROOT_DIR/node_modules/.bin/tsx" ]]; then
  echo '[✗] Las dependencias TypeScript todavía no están instaladas.' >&2
  echo '    Ejecuta una vez: npm install' >&2
  exit 1
fi

case "${1:-}" in
  view)
    shift
    exec "$ROOT_DIR/node_modules/.bin/tsx" "$ROOT_DIR/src/pc/pc-tree-cli.ts" view "$@"
    ;;
  -h|--help|help|'')
    cat <<'EOF'
AnSysWarden · PC

Uso:
  ./ansys-pc view <scan.json> [--out archivo.html]

Genera un HTML autónomo tipo TreeSize a partir de un ScanDocument existente.
No modifica ni elimina archivos.
EOF
    ;;
  *)
    echo "[✗] Comando PC desconocido: $1" >&2
    exit 1
    ;;
esac
