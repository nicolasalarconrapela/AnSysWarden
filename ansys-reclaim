#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ ! -x "$ROOT_DIR/node_modules/.bin/tsx" ]]; then
  printf '[AnSysWarden Reclaim] Faltan dependencias TypeScript. Ejecuta: npm install\n' >&2
  exit 1
fi

exec "$ROOT_DIR/node_modules/.bin/tsx" "$ROOT_DIR/src/reclaim/reclaim-cli.ts" "$@"
